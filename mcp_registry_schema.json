    {
      "name": "orchestrate_sales_intelligence",
      "description": "Analyzes captured lead data, evaluates sector-specific economics, and mathematically outputs the exact Goings OS products (Entry tiers, Custom UIs, Websites) to pitch in a comprehensive sales dossier before sales engagement.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "description": "Input schema for orchestrating sales intelligence dossier generation and mathematical product recommendation.",
        "required": [
          "lead_id",
          "prospect_name",
          "industry",
          "company_profile",
          "mandatory_directive_acknowledged"
        ],
        "properties": {
          "lead_id": {
            "type": "string",
            "description": "Unique identifier for the captured lead record."
          },
          "prospect_name": {
            "type": "string",
            "description": "Name of the target prospect company, enterprise organization, or executive lead."
          },
          "industry": {
            "type": "string",
            "description": "Target prospect industry or operational vertical."
          },
          "company_profile": {
            "type": "object",
            "description": "Firmographic parameters including revenue bracket, employee count, tech stack, and tech debt.",
            "required": [
              "annual_revenue_bracket",
              "employee_count",
              "estimated_tech_debt_score"
            ],
            "properties": {
              "annual_revenue_bracket": {
                "type": "string",
                "enum": [
                  "under_250k",
                  "250k_to_1m",
                  "1m_to_5m",
                  "5m_to_25m",
                  "over_25m"
                ],
                "description": "Annual revenue bracket used for pricing calibration and budget multiplier computation."
              },
              "employee_count": {
                "type": "integer",
                "minimum": 1,
                "description": "Total headcount of the prospect organization."
              },
              "current_tech_stack": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Existing software systems, CRMs, and infrastructure tools."
              },
              "estimated_tech_debt_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "Subjective or assessed technical debt severity on a 0 to 100 scale."
              }
            }
          },
          "operational_bottlenecks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Primary operational failure points."
          },
          "sales_readiness_status": {
            "type": "string",
            "enum": [
              "INTAKE_CAPTURED",
              "ANALYSIS_REQUIRED",
              "DOSSIER_COMPILED",
              "READY_FOR_SALES_CALL"
            ],
            "default": "INTAKE_CAPTURED",
            "description": "Workflow phase of the captured lead."
          },
          "mandatory_directive_acknowledged": {
            "type": "boolean",
            "description": "MANDATORY GATE: Must be true certifying that the sales dossier and mathematical product suite are compiled before sales engagement."
          },
          "metadata": {
            "type": "object",
            "description": "Optional tracking parameters and CRM sync identifiers.",
            "properties": {
              "crm_source": {
                "type": "string"
              },
              "lead_capture_timestamp": {
                "type": "string"
              }
            }
          }
        }
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "description": "MCP inputSchema for orchestrate_sales_intelligence.",
        "required": [
          "lead_id",
          "prospect_name",
          "industry",
          "company_profile",
          "mandatory_directive_acknowledged"
        ],
        "properties": {
          "lead_id": {
            "type": "string"
          },
          "prospect_name": {
            "type": "string"
          },
          "industry": {
            "type": "string"
          },
          "company_profile": {
            "type": "object"
          },
          "operational_bottlenecks": {
            "type": "array"
          },
          "sales_readiness_status": {
            "type": "string"
          },
          "mandatory_directive_acknowledged": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
