    {
      "name": "orchestrate_ui_component",
      "description": "Generates production-grade React TypeScript components, Tailwind CSS styling tokens, and dark mode enterprise interfaces. Enforces mandatory operator intake interview to capture layout constraints, data visualization needs, and color palette parameters prior to component synthesis.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "description": "Input parameters for drafting enterprise React and Tailwind dark mode UI components.",
        "required": [
          "component_name",
          "layout_constraints",
          "data_visualization_needs",
          "color_palette_parameters",
          "operator_confirmed"
        ],
        "properties": {
          "component_name": {
            "type": "string",
            "description": "PascalCase name of the React component (e.g. 'ExecutiveTelemetryDashboard', 'VaultAuditLedger')."
          },
          "description": {
            "type": "string",
            "description": "Functional description and user journey context for this interface."
          },
          "layout_constraints": {
            "type": "object",
            "description": "Spatial geometry, responsive container boundaries, and padding density rules.",
            "required": [
              "container_width",
              "breakpoint_target"
            ],
            "properties": {
              "container_width": {
                "type": "string",
                "enum": [
                  "full_bleed",
                  "max_w_7xl",
                  "max_w_5xl",
                  "modal_centered",
                  "sidebar_split"
                ],
                "default": "max_w_7xl"
              },
              "breakpoint_target": {
                "type": "string",
                "enum": [
                  "mobile_responsive",
                  "desktop_only",
                  "ultrawide_dashboard"
                ],
                "default": "mobile_responsive"
              },
              "spacing_density": {
                "type": "string",
                "enum": [
                  "compact_dense",
                  "standard",
                  "spacious_executive"
                ],
                "default": "standard"
              }
            }
          },
          "data_visualization_needs": {
            "type": "object",
            "description": "Charts, gauges, data tables, and metrics widgets to integrate.",
            "required": [
              "chart_types",
              "metrics_to_display"
            ],
            "properties": {
              "chart_types": {
                "type": "array",
                "description": "Chart and visualization types required.",
                "items": {
                  "type": "string",
                  "enum": [
                    "area_chart",
                    "bar_chart",
                    "donut_breakdown",
                    "sparklines",
                    "live_stream_gauge",
                    "kpi_stat_cards",
                    "sortable_data_table"
                  ]
                }
              },
              "metrics_to_display": {
                "type": "array",
                "description": "Key telemetry and business metrics to visualize.",
                "items": {
                  "type": "string"
                }
              },
              "interactive_filters": {
                "type": "array",
                "description": "User controls (e.g. date range, search, category filter).",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "color_palette_parameters": {
            "type": "object",
            "description": "Dark mode enterprise theme tokens and hex color palette.",
            "required": [
              "primary_brand_hex",
              "accent_hex",
              "surface_dark_hex"
            ],
            "properties": {
              "theme_mode": {
                "type": "string",
                "enum": [
                  "dark_only",
                  "dark_preferred",
                  "light_dark_toggle"
                ],
                "default": "dark_only"
              },
              "primary_brand_hex": {
                "type": "string",
                "default": "#1B365D"
              },
              "accent_hex": {
                "type": "string",
                "default": "#C5A059"
              },
              "surface_dark_hex": {
                "type": "string",
                "default": "#0B1120"
              },
              "border_subtle_hex": {
                "type": "string",
                "default": "#1E293B"
              },
              "glassmorphism_enabled": {
                "type": "boolean",
                "default": true
              }
            }
          },
          "operator_confirmed": {
            "type": "boolean",
            "description": "MANDATORY GATE: Must be true certifying that the operator answered layout, visualization, and palette questions."
          },
          "metadata": {
            "type": "object",
            "description": "Enterprise tracking parameters.",
            "properties": {
              "project_id": {
                "type": "string"
              },
              "module_node": {
                "type": "string"
              }
            }
          }
        }
      },
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "description": "MCP inputSchema for orchestrate_ui_component.",
        "required": [
          "component_name",
          "layout_constraints",
          "data_visualization_needs",
          "color_palette_parameters",
          "operator_confirmed"
        ],
        "properties": {
          "component_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "layout_constraints": {
            "type": "object"
          },
          "data_visualization_needs": {
            "type": "object"
          },
          "color_palette_parameters": {
            "type": "object"
          },
          "operator_confirmed": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          }
        }
      }
